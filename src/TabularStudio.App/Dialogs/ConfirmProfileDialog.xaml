<Window x:Class="TabularStudio.App.Dialogs.ConfirmProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       Text="确认操作"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1"
                          MaxHeight="240"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="MainMessageTextBlock"
                               Text="确定要执行此操作吗？"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#1F2937"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />

                    <TextBlock x:Name="SubMessageTextBlock"
                               Text="此操作无法撤销。"
                               FontSize="12"
                               Foreground="#6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ConfirmButton"
                        Grid.Column="1"
                        Content="确认"
                        MinHeight="32"
                        MinWidth="72"
                        Padding="12,4"
                        Margin="0,0,8,0"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Medium"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="OnConfirmClick" />

                <Button Grid.Column="2"
                        Content="取消"
                        MinHeight="32"
                        MinWidth="72"
                        Padding="12,4"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
