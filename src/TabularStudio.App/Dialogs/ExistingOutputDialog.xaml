<Window x:Class="TabularStudio.App.Dialogs.ExistingOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输出文件已存在"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="目标输出文件已存在"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"
                       Margin="0,0,0,12" />

            <TextBlock Text="以下路径的文件已经存在，请选择如何处理："
                       FontSize="13"
                       Foreground="#4B5563"
                       Margin="0,0,0,8" />

            <Border Background="#E5E7EB"
                    Padding="10,8"
                    CornerRadius="4"
                    Margin="0,0,0,16">
                <TextBlock x:Name="FilePathTextBlock"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#111827" />
            </Border>

            <TextBlock Text="• 覆盖：使用新生成的表格替换现有文件&#x0a;• 另存为：指定新的文件名或保存路径&#x0a;• 取消：放弃本次操作并返回配置界面"
                       FontSize="12"
                       Foreground="#6B7280"
                       LineHeight="20"
                       Margin="0,0,0,24" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="覆盖"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Background="#DC2626"
                        Foreground="White"
                        FontWeight="Medium"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnOverwriteClick" />

                <Button Grid.Column="2"
                        Content="另存为..."
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Medium"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnSaveAsClick" />

                <Button Grid.Column="3"
                        Content="取消"
                        Padding="16,6"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
