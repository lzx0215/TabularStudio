<Window x:Class="TabularStudio.App.Dialogs.ExistingOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输出文件已存在"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="目标输出文件已存在"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="0,0,0,12" />

            <TextBlock Text="以下路径的文件已经存在，请选择如何处理："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <Border Style="{StaticResource InsetPanelStyle}" Padding="10,8" Margin="0,0,0,16">
                <TextBlock x:Name="FilePathTextBlock"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <TextBlock Text="• 覆盖：使用新生成的表格替换现有文件&#x0a;• 另存为：指定新的文件名或保存路径&#x0a;• 取消：放弃本次操作并返回配置界面"
                       Style="{StaticResource CaptionStyle}"
                       LineHeight="20"
                       Margin="0,0,0,24" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="覆盖"
                        Style="{StaticResource DangerButtonStyle}"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        Click="OnOverwriteClick" />

                <Button Grid.Column="2"
                        Content="另存为..."
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Click="OnSaveAsClick" />

                <Button Grid.Column="3"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="84"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
