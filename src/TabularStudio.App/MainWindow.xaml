<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
        xmlns:views="clr-namespace:TabularStudio.App.Views"
        x:Class="TabularStudio.App.MainWindow"
        mc:Ignorable="d"
        Title="TabularStudio - 本地离线表格工具"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BatchFormatViewModel}">
            <views:BatchFormatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FormatStandardizationViewModel}">
            <views:FormatStandardizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataMatchingViewModel}">
            <views:DataMatchingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TableComparisonViewModel}">
            <views:TableComparisonView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧垂直导航栏 (210 DIP) -->
            <ColumnDefinition Width="210"/>
            <!-- 极细 1 DIP 垂直分割线 -->
            <ColumnDefinition Width="1"/>
            <!-- 右侧主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧工作台导航栏 (#262B2C 表面) -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}" Padding="14,14,14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 紧凑产品名区 -->
                    <RowDefinition Height="Auto"/> <!-- 分割线 -->
                    <RowDefinition Height="*"/>    <!-- 三大主导航 -->
                    <RowDefinition Height="Auto"/> <!-- 底部状态信息 -->
                </Grid.RowDefinitions>

                <!-- 紧凑产品名标识 (无巨大Logo/大标题，不占用垂直空间) -->
                <DockPanel Grid.Row="0" Margin="4,2,4,10" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="TabularStudio" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 导航顶部分割线 -->
                <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,12"/>

                <!-- 三大核心功能导航 (单色、中等线宽、明确几何、导航尺寸 20 DIP) -->
                <StackPanel Grid.Row="2">
                    <!-- 导航 1：格式统一 (Sliders / Table rule normalization) -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsFormatStandardizationSelected, Mode=TwoWay}"
                                 Command="{Binding SelectFormatStandardizationCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFormatNormalizationGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="格式统一" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 导航 2：数据匹配 (Relational link geometry) -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsDataMatchingSelected, Mode=TwoWay}"
                                 Command="{Binding SelectDataMatchingCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDataMatchingGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="数据匹配" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 导航 3：表格对比 (Bidirectional difference geometry) -->
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding IsTableComparisonSelected, Mode=TwoWay}"
                                 Command="{Binding SelectTableComparisonCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTableComparisonGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="20" Height="20" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="表格对比" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部极简离线就绪指示 (不占用空间) -->
                <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="4,10,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="离线工作台已就绪" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 垂直分割线 (极细 1 DIP，#747977 40% 不透明度) -->
        <Border Grid.Column="1" Background="{StaticResource DividerBrush}"/>

        <!-- 右侧主工作区 -->
        <ContentControl Grid.Column="2" Content="{Binding CurrentViewViewModel}" Background="Transparent"/>
    </Grid>
</Window>
