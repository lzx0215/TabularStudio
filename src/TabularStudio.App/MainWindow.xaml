<Window x:Class="TabularStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
        xmlns:views="clr-namespace:TabularStudio.App.Views"
        mc:Ignorable="d"
        Title="TabularStudio - 本地离线表格工具"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableComparisonViewModel}">
            <views:TableComparisonView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchFormatViewModel}">
            <views:BatchFormatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FormatStandardizationViewModel}">
            <views:FormatStandardizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataMatchingViewModel}">
            <views:DataMatchingView />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource ContentPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶部导航条 (48 DIP) -->
        <Grid Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,28,0">
                <TextBlock Text="TabularStudio"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="{StaticResource DividerBrush}" Margin="12,0" VerticalAlignment="Center" />
                <TextBlock Text="本地离线表格工具"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource TopNavTabStyle}"
                             IsChecked="{Binding IsFormatStandardizationSelected, Mode=TwoWay}"
                             Command="{Binding SelectFormatStandardizationCommand}"
                             AutomationProperties.Name="格式统一">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavGlyphStyle}" Data="{StaticResource IconFormat}" Margin="0,0,6,0" Width="15" Height="15" />
                        <TextBlock Text="格式统一" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopNavTabStyle}"
                             IsChecked="{Binding IsDataMatchingSelected, Mode=TwoWay}"
                             Command="{Binding SelectDataMatchingCommand}"
                             AutomationProperties.Name="数据匹配">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavGlyphStyle}" Data="{StaticResource IconMatch}" Margin="0,0,6,0" Width="15" Height="15" />
                        <TextBlock Text="数据匹配" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource TopNavTabStyle}"
                             IsChecked="{Binding IsTableComparisonSelected, Mode=TwoWay}"
                             Command="{Binding SelectTableComparisonCommand}"
                             AutomationProperties.Name="表格对比">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavGlyphStyle}" Data="{StaticResource IconCompare}" Margin="0,0,6,0" Width="15" Height="15" />
                        <TextBlock Text="表格对比" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="{StaticResource IconOffline}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="完全离线" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text=" · 文件仅在本机处理" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource HairlineStyle}" />

        <!-- 主工作区 -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewViewModel}" />

        <Border Grid.Row="3" Style="{StaticResource HairlineStyle}" />

        <!-- 全局状态条 (28 DIP) -->
        <DockPanel Grid.Row="4" Margin="24,0">
            <TextBlock DockPanel.Dock="Right"
                       Text="离线环境已就绪"
                       Foreground="{StaticResource SuccessBrush}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
