<Window x:Class="TabularStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
        xmlns:views="clr-namespace:TabularStudio.App.Views"
        mc:Ignorable="d"
        Title="TabularStudio - 本地离线表格工具"
        Width="1100"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FormatStandardizationViewModel}">
            <views:FormatStandardizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataMatchingViewModel}">
            <views:DataMatchingView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 主内容区：左侧侧边栏 + 右侧功能页面 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航侧边栏 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Logo / Title -->
                        <RowDefinition Height="Auto" /> <!-- 分割线 -->
                        <RowDefinition Height="*" />    <!-- 导航菜单 -->
                        <RowDefinition Height="Auto" /> <!-- 底部版本信息 -->
                    </Grid.RowDefinitions>

                    <!-- Logo / 产品标题 -->
                    <StackPanel Grid.Row="0" Margin="0,8,0,16">
                        <TextBlock Text="TabularStudio"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="本地离线表格处理"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 分割线 -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,16" />

                    <!-- 导航按钮列表 -->
                    <StackPanel Grid.Row="2">
                        <RadioButton Content="格式统一"
                                     Style="{StaticResource NavButtonStyle}"
                                     IsChecked="{Binding IsFormatStandardizationSelected, Mode=TwoWay}"
                                     Command="{Binding SelectFormatStandardizationCommand}" />

                        <RadioButton Content="数据匹配"
                                     Style="{StaticResource NavButtonStyle}"
                                     IsChecked="{Binding IsDataMatchingSelected, Mode=TwoWay}"
                                     Command="{Binding SelectDataMatchingCommand}" />
                    </StackPanel>

                    <!-- 底部版本与环境标识 -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="v0.1.0 MVP"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Windows 本地完全离线"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧主工作区 -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewViewModel}" />
        </Grid>

        <!-- 全局底部状态栏 -->
        <Border Grid.Row="1"
                Background="#E5E7EB"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="离线环境已就绪"
                           FontSize="11"
                           Foreground="#047857"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
