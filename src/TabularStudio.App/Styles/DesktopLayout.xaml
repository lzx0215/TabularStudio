<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesktopControls.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="Desktop.BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Desktop.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Desktop.BodySize}" />
        <Setter Property="LineHeight" Value="{StaticResource Desktop.BodyLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource Desktop.TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Desktop.PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Desktop.TitleSize}" />
        <Setter Property="LineHeight" Value="{StaticResource Desktop.TitleLineHeight}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Desktop.SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Desktop.SectionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Desktop.CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource Desktop.SecondarySize}" />
        <Setter Property="LineHeight" Value="{StaticResource Desktop.SecondaryLineHeight}" />
        <Setter Property="Foreground" Value="{StaticResource Desktop.SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Desktop.FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Desktop.SecondaryTextBrush}" />
    </Style>
    <Style x:Key="Desktop.PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.CaptionStyle}" />
    <Style x:Key="Desktop.DividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.DividerBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="Desktop.VerticalDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.DividerBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="Desktop.DataToolbarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style x:Key="Desktop.FormToolbarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style x:Key="Desktop.BottomActionAreaStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.SubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Desktop.DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <Style x:Key="Desktop.EmptyOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.SurfaceBrush}" />
    </Style>
    <Style x:Key="Desktop.ErrorMessageStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.ErrorSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Desktop.ErrorBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="{StaticResource Desktop.Inset8}" />
    </Style>
    <Style x:Key="Desktop.ProtectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Desktop.SubtleBrush}" />
        <Setter Property="Padding" Value="{StaticResource Desktop.Inset8}" />
    </Style>
    <Style x:Key="Desktop.ButtonGlyphStyle" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Desktop.IconSize}" />
        <Setter Property="Height" Value="{StaticResource Desktop.IconSize}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Margin" Value="{StaticResource Desktop.RightGap}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Desktop.StrokeButtonGlyphStyle" TargetType="Path" BasedOn="{StaticResource Desktop.ButtonGlyphStyle}">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="Desktop.NavGlyphStyle" TargetType="Path" BasedOn="{StaticResource Desktop.StrokeButtonGlyphStyle}">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>
    <Style x:Key="Desktop.TopNavItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Workspace"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Desktop.SecondaryTextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Sheet" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="12,0" Margin="0" SnapsToDevicePixels="True">
                <Grid>
                    <Border x:Name="Selection" Height="2" Background="Transparent" VerticalAlignment="Bottom"/>
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sheet" Property="Background" Value="{StaticResource Desktop.HoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Sheet" Property="Background" Value="{StaticResource Desktop.SelectedBrush}"/><Setter TargetName="Selection" Property="Background" Value="{StaticResource Desktop.PrimaryBrush}"/><Setter Property="Foreground" Value="{StaticResource Desktop.PrimaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Desktop.StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Desktop.CaptionStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
