<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TabularStudio.App.Views.BatchFormatView" Background="Transparent" FontFamily="{StaticResource Desktop.FontFamily}" FontSize="13" SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="16,6,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 页头：标题 + 配置条 -->
        <Grid Grid.Row="0" Margin="0" MinHeight="40" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="格式统一" Style="{StaticResource Desktop.PageTitleStyle}"/>
                <TextBlock Text="清理格式，保留编号与公式；每个文件分别生成结果。" Style="{StaticResource Desktop.PageSubtitleStyle}" Margin="0" Visibility="Collapsed"/>
            </StackPanel>
            <!-- 处理配置条 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="处理配置" Style="{StaticResource Desktop.FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Grid Width="150" Margin="0,0,8,0">
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" IsEnabled="{Binding CanSelectProfile}" AutomationProperties.Name="处理配置" Style="{StaticResource Desktop.ComboBoxStyle}"/>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,28,0" Foreground="{StaticResource Desktop.SecondaryTextBrush}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="请选择配置…"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                                            <Setter Property="Text" Value="暂无保存配置"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasProfiles}" Value="True"/>
                                                <Condition Binding="{Binding SelectedProfile}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="请选择配置…"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="应用" Command="{Binding ApplyProfileCommand}" IsEnabled="{Binding CanApplyProfile}" Margin="0,0,8,0" Padding="{StaticResource Desktop.ButtonPadding}" Style="{StaticResource Desktop.SecondaryButtonStyle}"/>
                    <Button Content="保存配置…" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding CanSaveProfile}" Margin="0,0,8,0" Padding="{StaticResource Desktop.ButtonPadding}" Style="{StaticResource Desktop.SecondaryButtonStyle}"/>
                    <Button Content="删除" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanDeleteProfile}" Padding="{StaticResource Desktop.ButtonPadding}" Style="{StaticResource Desktop.SecondaryButtonStyle}"/>
                </StackPanel>
                <ScrollViewer MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ProfileStatusMessage}" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Desktop.SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Desktop.ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProfileStatusModified}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Desktop.WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProfileStatusSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Desktop.SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Desktop.DividerStyle}" Margin="0,0,0,8" Visibility="Collapsed"/>
        <!-- 主工作区 -->
        <Grid x:Name="RootGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkbenchRow" Height="*"/>
                <RowDefinition x:Name="RulesRowSplitter" Height="0"/>
                <RowDefinition x:Name="RulesRow" Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="220" MinWidth="176"/>
                <ColumnDefinition x:Name="FilesSplitter" Width="16"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="320"/>
                <ColumnDefinition x:Name="RulesSplitter" Width="16"/>
                <ColumnDefinition x:Name="RulesColumn" Width="216" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <!-- 文件列表 -->
            <Grid x:Name="FilesPanel" Grid.Column="0" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Style="{StaticResource Desktop.DividerStyle}"/>
                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" MinHeight="0" IsEnabled="{Binding CanConfigure}" HorizontalContentAlignment="Stretch" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{StaticResource Desktop.ListBoxStyle}" ItemContainerStyle="{StaticResource Desktop.ListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="8">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="勾选后可修改或移除" AutomationProperties.Name="勾选用于修改或移除" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" FontSize="13"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="当前预览" FontSize="12" Foreground="{StaticResource Desktop.PrimaryBrush}" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ResultText}" FontSize="12" Foreground="{StaticResource Desktop.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultText}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="拖拽或添加 .xlsx / .xls / .csv 文件" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Desktop.CaptionStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Row="4" Text="勾选用于修改或移除；单击文件名作为当前预览。" Style="{StaticResource Desktop.CaptionStyle}" Margin="0,8,0,0"/>
            <DockPanel Height="32"><StackPanel Grid.Row="0" IsEnabled="{Binding CanConfigure}" Margin="4,0,0,0" Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Command="{Binding BrowseFilesCommand}" Style="{StaticResource Desktop.CompactSecondaryButtonStyle}" Margin="0,0,3,0" ToolTip="添加一个或多个表格文件" AutomationProperties.Name="添加文件" MinWidth="32" Padding="3,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="添加" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReplaceCheckedFilesCommand}" IsEnabled="{Binding HasCheckedFiles}" Style="{StaticResource Desktop.CompactSecondaryButtonStyle}" Margin="0,0,3,0" ToolTip="替换勾选的文件" AutomationProperties.Name="修改文件" MinWidth="32" Padding="3,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="修改" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasCheckedFiles}" Style="{StaticResource Desktop.CompactSecondaryButtonStyle}" Margin="0,0,3,0" ToolTip="移除勾选的文件" AutomationProperties.Name="移除文件" MinWidth="32" Padding="3,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="移除" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Files.Count, StringFormat='文件列表（{0}）'}" Style="{StaticResource Desktop.SectionTitleStyle}" Margin="0" FontSize="13"/>
                </DockPanel></Grid>
            <Border x:Name="FilesColumnLine" Grid.Column="1" Style="{StaticResource Desktop.VerticalDividerStyle}" HorizontalAlignment="Center" Width="1"/>
            <!-- 当前文件与预览 -->
            <Grid Grid.Column="2" IsEnabled="{Binding CanConfigure}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Style="{StaticResource Desktop.DividerStyle}"/>
                <TextBox Grid.Row="2" Text="{Binding SelectedFile.FilePath, Mode=OneWay}" Style="{StaticResource Desktop.CopyableMessageStyle}" Foreground="{StaticResource Desktop.TextBrush}" IsReadOnly="True" FontSize="12" Margin="0" TextWrapping="NoWrap" ToolTip="{Binding SelectedFile.FilePath}"/>
                <Grid Grid.Row="3" DataContext="{Binding SelectedFile.Editor}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="FilePreviewGrid" ItemsSource="{Binding PreviewDataTable.DefaultView}" AutoGeneratingColumn="OnPreviewAutoGeneratingColumn" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="80" Style="{StaticResource Desktop.DataGridStyle}"/>
                        <Border Style="{StaticResource Desktop.EmptyOverlayStyle}" Visibility="{Binding ShowPreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PreviewEmptyMessage}" Style="{StaticResource Desktop.CaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                        </Border>
                    </Grid>
                </Grid>
            <WrapPanel Grid.Row="0" VerticalAlignment="Center"><TextBlock Text="当前文件与预览" Style="{StaticResource Desktop.SectionTitleStyle}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="PreviewFileSelector" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" DisplayMemberPath="FileName" MinWidth="64" MaxWidth="112" Margin="0,0,8,0" ToolTip="{Binding SelectedFile.FilePath}" Style="{StaticResource Desktop.ComboBoxStyle}" Width="88" AutomationProperties.Name="当前预览文件"/>
                    <StackPanel Margin="0" DataContext="{Binding SelectedFile.Editor}" Orientation="Horizontal">
                        <DockPanel Visibility="{Binding HasWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,8,0" LastChildFill="True" MinWidth="0">
                            <TextBlock Text="工作表" Style="{StaticResource Desktop.FieldLabelStyle}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedWorksheet}" DisplayMemberPath="Name" MinWidth="64" ToolTip="选择要处理的工作表" Style="{StaticResource Desktop.ComboBoxStyle}" MaxWidth="88"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,8,0">
                            <TextBlock Text="表头行" Style="{StaticResource Desktop.FieldLabelStyle}" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding HeaderRowNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="48" ToolTip="表头所在行，从 1 开始" Style="{StaticResource Desktop.TextBoxStyle}"/>
                        </DockPanel>
                        <Button Command="{Binding RefreshPreviewCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Padding="6,0" Margin="0,0,8,0" ToolTip="重新读取预览" AutomationProperties.Name="刷新预览">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Desktop.StrokeButtonGlyphStyle}" Data="{StaticResource IconRefresh}" Visibility="Collapsed"/>
                                <TextBlock Text="刷新预览" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </WrapPanel></Grid>
            <Border x:Name="RulesColumnLine" Grid.Column="3" Style="{StaticResource Desktop.VerticalDividerStyle}" HorizontalAlignment="Center" Width="1"/>
            <!-- 整批共用规则 -->
            <ScrollViewer Background="{StaticResource Desktop.SubtleBrush}" Padding="8,4" x:Name="RulesPanel" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanConfigure}">
                <StackPanel>
                    <TextBlock Text="整批共用规则" Style="{StaticResource Desktop.SectionTitleStyle}" Margin="0"/>
                    <Border Style="{StaticResource Desktop.DividerStyle}" Margin="0,0,0,12"/>
                    <CheckBox Content="清理前后空格" IsChecked="{Binding Rules.TrimOuterWhitespace}" Margin="0,0,0,4" ToolTip="清理前后空格" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <CheckBox Content="清理隐藏字符 / Tab / 换行" IsChecked="{Binding Rules.RemoveTabsNewLinesAndHiddenCharacters}" Margin="0,0,0,4" ToolTip="清理 Tab / 换行 / 隐藏字符" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <CheckBox Content="全角 / 半角统一" IsChecked="{Binding Rules.NormalizeFullWidthHalfWidth}" Margin="0,0,0,4" ToolTip="全角 / 半角统一" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <CheckBox Content="Unicode 标准化" IsChecked="{Binding Rules.NormalizeUnicode}" Margin="0,0,0,4" ToolTip="Unicode 标准化" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <CheckBox Content="普通数字安全统一" IsChecked="{Binding Rules.NormalizeSafeNumbers}" Margin="0,0,0,4" ToolTip="普通数字安全统一" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <CheckBox Content="明确日期安全统一" IsChecked="{Binding Rules.NormalizeUnambiguousDates}" Margin="0,0,0,4" ToolTip="明确日期安全统一" Style="{StaticResource Desktop.CheckBoxStyle}"/>
                    <Border Style="{StaticResource Desktop.ProtectionStyle}" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource Desktop.WarningBrush}" StrokeThickness="1.4" Data="{StaticResource IconLock}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="前导 0、长数字始终保护；公式保持不变。以上保护不可关闭。可选规则默认不启用。" FontSize="12" Foreground="{StaticResource Desktop.SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding RuleHint}" Foreground="{StaticResource Desktop.WarningBrush}" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="RulesRowLine" Grid.Row="1" Grid.Column="2" Style="{StaticResource Desktop.DividerStyle}" Margin="0,8,0,8" Visibility="Collapsed"/>
            <!-- 错误 -->
            <ScrollViewer Grid.Row="3" Grid.ColumnSpan="5" VerticalScrollBarVisibility="Auto" MaxHeight="96" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedFile.Editor.ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Desktop.ErrorBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Desktop.ErrorMessageStyle}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBox Text="{Binding FilePath, Mode=OneWay, StringFormat='失败文件：{0}'}" Style="{StaticResource Desktop.CopyableMessageStyle}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Desktop.ErrorBrush}" IsReadOnly="True"/>
                                        <TextBox Text="{Binding Reason, Mode=OneWay, StringFormat='原因：{0}'}" Style="{StaticResource Desktop.CopyableMessageStyle}" TextWrapping="Wrap" Margin="0,4,0,0" IsReadOnly="True"/>
                                        <TextBox Text="{Binding Context, Mode=OneWay}" Style="{StaticResource Desktop.CopyableMessageStyle}" TextWrapping="Wrap" Margin="0,4,0,0" IsReadOnly="True"/>
                                        <TextBox Text="{Binding Detail, Mode=OneWay, StringFormat='详情：{0}'}" Style="{StaticResource Desktop.CopyableMessageStyle}" TextWrapping="Wrap" Margin="0,4,0,0" IsReadOnly="True"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Failures.Count}" Value="0"/>
                                    <Condition Binding="{Binding SelectedFile.Editor.HasError, TargetNullValue=False, FallbackValue=False}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
            </ScrollViewer>
            <Border x:Name="FixedFooter" Grid.Row="4" Grid.ColumnSpan="5" Style="{StaticResource Desktop.BottomActionAreaStyle}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" x:Name="FooterOutputScroll"><Grid MinWidth="420" Width="{Binding ActualWidth, ElementName=FooterOutputScroll}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel x:Name="SelectedOutputRow" Grid.Row="0" DataContext="{Binding SelectedFile.Editor}" IsEnabled="{Binding DataContext.CanConfigure, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="0" Height="32">
                        <TextBlock DockPanel.Dock="Left" Text="此文件输出" Style="{StaticResource Desktop.FieldLabelStyle}" Margin="0,0,8,0" FontSize="12"/>
                        <Button DockPanel.Dock="Right" Command="{Binding ChangeOutputPathCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Margin="8,0,0,0" Padding="6,0" AutomationProperties.Name="此文件输出路径" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Desktop.ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock Text="此文件输出…" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding OutputFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFilePath}" Style="{StaticResource Desktop.ReadOnlyPathStyle}"/>
                    </DockPanel>
                    <DockPanel Grid.Row="0" Grid.Column="2" Height="32">
                        <TextBlock Text="整批输出" Style="{StaticResource Desktop.FieldLabelStyle}" Margin="0,0,8,0" FontSize="12"/>
                        <Button DockPanel.Dock="Right" Command="{Binding ChooseOutputDirectoryCommand}" IsEnabled="{Binding CanConfigure}" Margin="8,0,0,0" AutomationProperties.Name="更改输出目录" Style="{StaticResource Desktop.SecondaryButtonStyle}" Padding="6,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Desktop.ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock Text="更改目录" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding OutputDirectoryDisplay, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputDirectoryDisplay}" Style="{StaticResource Desktop.ReadOnlyPathStyle}"/>
                    </DockPanel>
                    </Grid></ScrollViewer><StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2">
                        <Button Content="所选结果用于匹配" Command="{Binding SendSelectedToMatchingCommand}" IsEnabled="{Binding CanUseSelectedResult}" Margin="0,0,8,0" Style="{StaticResource Desktop.SecondaryButtonStyle}" Padding="6,0" FontSize="12" MinWidth="64"/>
                        <Button Command="{Binding OpenSelectedResultCommand}" IsEnabled="{Binding CanUseSelectedResult}" Margin="0,0,8,0" Style="{StaticResource Desktop.SecondaryButtonStyle}" Padding="6,0" FontSize="12" MinWidth="64">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Desktop.ButtonGlyphStyle}" Data="{StaticResource IconFile}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock Text="打开结果" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenSelectedDirectoryCommand}" IsEnabled="{Binding CanUseSelectedResult}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Padding="6,0" FontSize="12" MinWidth="64">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Desktop.ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock Text="打开目录" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    <Button x:Name="StartButton" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource Desktop.PrimaryButtonStyle}" MinWidth="96" AutomationProperties.Name="开始处理" HorizontalAlignment="Right" Margin="8,0,0,0" Padding="6,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Desktop.ButtonGlyphStyle}" Data="{StaticResource IconPlay}" Fill="{StaticResource Desktop.SurfaceBrush}" Visibility="Collapsed"/>
                            <TextBlock Text="开始处理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </Grid><StackPanel Margin="0" Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding Summary}" TextWrapping="NoWrap" FontSize="12" Foreground="{StaticResource Desktop.SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip="{Binding Summary}"/>
                        <ProgressBar Value="{Binding ProgressPercent}" Margin="12,0,0,0" Style="{StaticResource Desktop.ProgressBarStyle}" Width="120" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid></Border>
        </Grid>
    </Grid>
</UserControl>
