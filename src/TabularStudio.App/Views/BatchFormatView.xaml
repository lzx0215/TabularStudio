<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             x:Class="TabularStudio.App.Views.BatchFormatView"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 统一 Page Header + Divider -->
            <RowDefinition Height="*"/>    <!-- 主工作区：文件列表 | 预览与配置 | 共用规则 -->
            <RowDefinition Height="Auto"/> <!-- 错误反馈展开区 -->
            <RowDefinition Height="Auto"/> <!-- 固定底部控制栏 (FixedFooter) -->
        </Grid.RowDefinitions>

        <!-- 页面顶部结构: Page Header (26 DIP SemiBold Gold) + 细长水平分割线 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="格式统一" Style="{StaticResource PageHeaderStyle}"/>
                <TextBlock DockPanel.Dock="Right" Text="离线批处理 · 前导0与长数字自动保护"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- 主三栏布局: 文件列表 | 预览与配置 | 共用规则 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2.2*" MinWidth="260"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.1*" MinWidth="190"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：文件资源列表 (桌面工具资源树风格，无厚重外壳) -->
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Files.Count, StringFormat='文件列表（{0}）'}" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 文件操作紧凑工具栏 -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8" Grid.Row="1">
                        <Button Content="添加文件" Command="{Binding BrowseFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="修改" Command="{Binding ReplaceCheckedFilesCommand}" IsEnabled="{Binding HasCheckedFiles}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="移除" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding HasCheckedFiles}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>

                    <!-- 文件列表 -->
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             MinHeight="0" IsEnabled="{Binding CanConfigure}" HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent" Grid.Row="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="勾选后可批量修改或移除"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding FileName}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding ResultText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultText}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="勾选复选框可进行修改或移除。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Grid.Row="3"/>
                </Grid>
            </Border>

            <!-- 中栏：当前文件预览与配置 (最大化 DataGrid 空间) -->
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12"
                    IsEnabled="{Binding CanConfigure}" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 文件选择器与路径 -->
                        <RowDefinition Height="Auto"/> <!-- Sheet 与表头行设置工具行 -->
                        <RowDefinition Height="*"/>    <!-- DataGrid 预览主空间 -->
                        <RowDefinition Height="Auto"/> <!-- 单文件输出路径 -->
                    </Grid.RowDefinitions>

                    <!-- 文件切换与路径 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前文件:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PreviewFileSelector" Grid.Column="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" DisplayMemberPath="FileName" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2" Text="{Binding SelectedFile.FilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding SelectedFile.FilePath, Mode=OneWay}"/>
                    </Grid>

                    <!-- Sheet / Header Row 紧凑表单行 -->
                    <Grid Grid.Row="1" DataContext="{Binding SelectedFile.Editor}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="工作表:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding HasWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Worksheets}" SelectedItem="{Binding SelectedWorksheet}" DisplayMemberPath="Name"
                                  Margin="0,0,10,0" Visibility="{Binding HasWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="2" Text="表头所在行:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding HeaderRowNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 Margin="0,0,8,0" HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="4" Content="刷新预览" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- DataGrid 数据预览 (深色表体、轻微区分Header、细分割线) -->
                    <Grid Grid.Row="2" DataContext="{Binding SelectedFile.Editor}">
                        <DataGrid x:Name="FilePreviewGrid" ItemsSource="{Binding PreviewDataTable.DefaultView}"
                                  AutoGeneratingColumn="OnPreviewAutoGeneratingColumn" IsReadOnly="True"
                                  AutoGenerateColumns="True" CanUserAddRows="False"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- 逐文件输出路径设置 -->
                    <DockPanel Grid.Row="3" DataContext="{Binding SelectedFile.Editor}" Margin="0,8,0,0">
                        <TextBlock Text="此文件输出:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="更改…" Command="{Binding ChangeOutputPathCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding OutputFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFilePath}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 右栏：整批共用规则 (处理配置 / 标准化规则 / 安全保护，Divider 区分) -->
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="14"
                    IsEnabled="{Binding CanConfigure}" Grid.Column="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 区域标题 -->
                        <TextBlock Text="整批共用规则" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,2,0,10"/>

                        <!-- 6 项标准化规则 -->
                        <StackPanel Margin="0,0,0,6">
                            <CheckBox Content="清理前后空格" IsChecked="{Binding Rules.TrimOuterWhitespace}" Margin="0,0,0,8" ToolTip="清理单元格首尾的空白字符"/>
                            <CheckBox Content="清理 Tab / 换行 / 隐藏字符" IsChecked="{Binding Rules.RemoveTabsNewLinesAndHiddenCharacters}" Margin="0,0,0,8" ToolTip="清理换行符与隐藏控制字符"/>
                            <CheckBox Content="全角 / 半角统一" IsChecked="{Binding Rules.NormalizeFullWidthHalfWidth}" Margin="0,0,0,8" ToolTip="将全角字母数字及常用标点转为标准半角"/>
                            <CheckBox Content="Unicode 标准化 (NFKC)" IsChecked="{Binding Rules.NormalizeUnicode}" Margin="0,0,0,8" ToolTip="兼容分解与重组标准化"/>
                            <CheckBox Content="普通数字安全统一" IsChecked="{Binding Rules.NormalizeSafeNumbers}" Margin="0,0,0,8" ToolTip="标准数字规范化"/>
                            <CheckBox Content="明确日期安全统一" IsChecked="{Binding Rules.NormalizeUnambiguousDates}" Margin="0,0,0,8" ToolTip="规范标准日期格式"/>
                        </StackPanel>

                        <!-- 安全保护分区 -->
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,6,0,10"/>
                        <TextBlock Text="安全保护 (始终启用)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="• 前导 0 编号保护：身份证、工号不丢 0&#x0a;• 超长数字保护：大数值文本不截断&#x0a;• 公式原生保护：计算式维持原样"
                                   LineHeight="18" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>

                        <!-- 规则提示 -->
                        <TextBlock Text="{Binding RuleHint}" Foreground="{StaticResource AccentGoldBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 失败与错误详情面板 (可伸缩) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96" Margin="0,0,0,6" Grid.Row="2">
            <StackPanel>
                <TextBlock Text="{Binding SelectedFile.Editor.ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Failures}" Margin="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource DangerBackgroundBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBox Text="{Binding FilePath, Mode=OneWay, StringFormat='失败文件：{0}'}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
                                    <TextBox Text="{Binding Reason, Mode=OneWay, StringFormat='原因：{0}'}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
                                    <TextBox Text="{Binding Context, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
                                    <TextBox Text="{Binding Detail, Mode=OneWay, StringFormat='详情：{0}'}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Failures.Count}" Value="0"/>
                                <Condition Binding="{Binding SelectedFile.Editor.HasError, TargetNullValue=False, FallbackValue=False}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
        </ScrollViewer>

        <!-- 底部固定 Execution Bar (FixedFooter) -->
        <Border x:Name="FixedFooter" Grid.Row="3" Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 输出目录配置与开始处理 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,14,0">
                        <TextBlock Text="整批输出目录:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="更改目录" Command="{Binding ChooseOutputDirectoryCommand}" IsEnabled="{Binding CanConfigure}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBox Text="{Binding OutputDirectoryDisplay, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputDirectoryDisplay}"/>
                    </DockPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Content="开始处理" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132"/>
                </Grid>

                <!-- 进度条、摘要与后续流转动作 -->
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="所选结果用于匹配" Command="{Binding SendSelectedToMatchingCommand}" IsEnabled="{Binding CanUseSelectedResult}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="打开结果" Command="{Binding OpenSelectedResultCommand}" IsEnabled="{Binding CanUseSelectedResult}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="打开目录" Command="{Binding OpenSelectedDirectoryCommand}" IsEnabled="{Binding CanUseSelectedResult}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                        <ProgressBar Value="{Binding ProgressPercent}" Height="5" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
