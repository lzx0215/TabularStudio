<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
             Background="Transparent"
             x:Class="TabularStudio.App.Views.DataMatchingView"
             d:DataContext="{d:DesignInstance Type=vm:DataMatchingViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="920"
             FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 统一 Page Header + Divider -->
            <RowDefinition Height="*"/>    <!-- 主工作区：双表预览 + 配置 -->
            <RowDefinition Height="Auto"/> <!-- 错误与冲突展开区 -->
            <RowDefinition Height="Auto"/> <!-- 固定底部控制栏 (FixedFooter) -->
        </Grid.RowDefinitions>

        <!-- 页面顶部结构: Page Header (26 DIP SemiBold Gold) + 细长水平分割线 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="数据匹配" Style="{StaticResource PageHeaderStyle}"/>
                <TextBlock DockPanel.Dock="Right" Text="基于多条件精确关联 · 支持同表关联与带回字段"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- 主内容区：上下两部分（双表预览 + 配置） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.95*"/>
                <RowDefinition Height="1.05*"/>
            </Grid.RowDefinitions>

            <!-- 顶部并排双表预览区 (等宽并列，精确对齐 Y 轴) -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 主表面板 -->
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12"
                        AllowDrop="True" DragOver="OnMasterDragOver" Drop="OnMasterDrop" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/> <!-- 行 0 高度严格锁定以保障组件测试 Y 坐标一致 -->
                            <RowDefinition Height="34"/> <!-- 行 1 高度严格锁定 -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 表头标题 -->
                        <TextBlock Text="主表 (Master Table)" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center" Grid.Row="0"/>

                        <!-- 表格配置行 (文件选择、Sheet、表头行) -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="0" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding MasterFilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding MasterFilePath, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseMasterFileCommand}" IsEnabled="{Binding CanBrowseMaster}" Margin="0,0,8,0" ToolTip="选择主表文件"/>
                            <TextBlock Visibility="{Binding HasMasterWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" Text="工作表:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="3" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="4" Visibility="{Binding HasMasterWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding MasterWorksheets}" SelectedItem="{Binding SelectedMasterWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="5" Text="表头行:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <Grid Grid.Column="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" HorizontalContentAlignment="Center" ToolTip="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="▲" FontSize="7" Height="14" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding IncrementMasterHeaderRowCommand}" MinHeight="0" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="▼" FontSize="7" Height="14" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding DecrementMasterHeaderRowCommand}" MinHeight="0" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 主表 DataGrid 预览 -->
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="MasterPreviewDataGrid" ItemsSource="{Binding MasterPreviewDataTable.DefaultView}"
                                      AutoGenerateColumns="True" AutoGeneratingColumn="OnMasterPreviewAutoGeneratingColumn"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                            <Border Background="{StaticResource PanelBackgroundAltBrush}" Visibility="{Binding ShowMasterPreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding MasterPreviewEmptyMessage}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 对照表面板 -->
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12"
                        AllowDrop="True" DragOver="OnReferenceDragOver" Drop="OnReferenceDrop" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/> <!-- 行 0 高度严格锁定以保障组件测试 Y 坐标一致 -->
                            <RowDefinition Height="34"/> <!-- 行 1 高度严格锁定 -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 表头标题与同表复选框 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="对照表 (Reference Table)" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <CheckBox Grid.Column="1" Content="同主表文件" ToolTip="与主表使用同一个文件" IsChecked="{Binding UseSameFileAsMaster}"
                                      IsEnabled="{Binding CanUseSameFile}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 表格配置行 (文件选择、Sheet、表头行) -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="0" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReferenceFilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,6,0" ToolTip="{Binding ReferenceFilePath, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseReferenceFileCommand}" IsEnabled="{Binding CanBrowseReference}" Margin="0,0,8,0" ToolTip="选择对照表文件"/>
                            <TextBlock Visibility="{Binding HasReferenceWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" Text="工作表:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="3" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="4" Visibility="{Binding HasReferenceWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding ReferenceWorksheets}" SelectedItem="{Binding SelectedReferenceWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="5" Text="表头行:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <Grid Grid.Column="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" HorizontalContentAlignment="Center" ToolTip="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="▲" FontSize="7" Height="14" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding IncrementReferenceHeaderRowCommand}" MinHeight="0" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="▼" FontSize="7" Height="14" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding DecrementReferenceHeaderRowCommand}" MinHeight="0" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 对照表 DataGrid 预览 -->
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="ReferencePreviewDataGrid" ItemsSource="{Binding ReferencePreviewDataTable.DefaultView}"
                                      AutoGenerateColumns="True" AutoGeneratingColumn="OnReferencePreviewAutoGeneratingColumn"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                            <Border Background="{StaticResource PanelBackgroundAltBrush}" Visibility="{Binding ShowReferencePreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding ReferencePreviewEmptyMessage}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 下部配置区：匹配条件 | 带回字段与筛选设置 (Divider 分割与局部滚动) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 匹配条件配置 -->
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="匹配条件 (所有条件必须同时满足 AND)" Style="{StaticResource SectionHeaderStyle}" Grid.Row="0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfigure}" Grid.Row="1">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Conditions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MatchingConditionRowViewModel}">
                                            <StackPanel Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index, StringFormat='条件 {0}:'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MasterColumns}" SelectedItem="{Binding SelectedMasterColumn}" DisplayMemberPath="DisplayName"/>
                                                    <!-- 金色箭头指示 (Accent Gold) -->
                                                    <Path Grid.Column="2" Data="{StaticResource IconArrowRightGeometry}"
                                                          Stroke="{StaticResource AccentGoldBrush}" StrokeThickness="1.8"
                                                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding ReferenceColumns}" SelectedItem="{Binding SelectedReferenceColumn}" DisplayMemberPath="DisplayName"/>
                                                    <Button Grid.Column="4" Content="删除" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Margin="8,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,8,0,0">
                                    <Button Content="+ 添加匹配条件" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddConditionCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8"/>
                                    <TextBlock Text="* 支持 1～N 条条件；空表头列不参与匹配；主表与对照表列对应相等即视作匹配。" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 带回字段与主表筛选设置 -->
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Grid.Column="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 带回字段区域 -->
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="带回字段" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedReturnFieldsCount, StringFormat='已选 {0} 项'}" FontSize="12" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchReturnFieldText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="全选" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllReturnFieldsCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="反选" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding InvertReturnFieldsCommand}" IsEnabled="{Binding CanConfigure}"/>
                                </Grid>
                                <!-- 紧凑 Checkbox + 字段名 (非卡片化) -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72" IsEnabled="{Binding CanConfigure}" MinHeight="28">
                                    <ItemsControl ItemsSource="{Binding ReturnFields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReturnFieldItemViewModel}">
                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,6" ToolTip="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,8,0,10"/>

                            <!-- 主表筛选与状态列配置 -->
                            <StackPanel>
                                <StackPanel IsEnabled="{Binding CanConfigure}" Margin="0,0,0,6">
                                    <CheckBox Content="仅匹配满足条件的主表行" IsChecked="{Binding IsMasterFilterEnabled}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,4" IsEnabled="{Binding IsMasterFilterEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主表:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding MasterAvailableColumns}" SelectedItem="{Binding SelectedMasterFilterColumn}" DisplayMemberPath="DisplayName" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="等于:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="MasterFilterValueSelector" Grid.Column="3" ItemsSource="{Binding MasterFilterValues}"
                                                  SelectedItem="{Binding SelectedMasterFilterValue}" DisplayMemberPath="DisplayText"
                                                  IsEditable="False" IsEnabled="{Binding CanSelectMasterFilterValue}" MaxDropDownHeight="240"/>
                                    </Grid>
                                    <TextBox Text="{Binding MasterFilterValuesMessage, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="56" BorderThickness="0" Padding="0" MinHeight="0"
                                             VerticalScrollBarVisibility="Auto" Background="Transparent" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                             Visibility="{Binding IsMasterFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <CheckBox Content="自动修复常见匹配差异 (空格/全半角/数字/日期统一，仅用于比较)" IsChecked="{Binding NormalizeComparisonKeys}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding CanConfigure}">
                                    <CheckBox Content="生成匹配状态列" IsChecked="{Binding IsStatusColumnEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="列名:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox Text="{Binding StatusColumnName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsStatusColumnEnabled}" Width="120" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 错误与警告展开面板 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96" Grid.Row="2">
            <StackPanel>
                <TextBox Text="{Binding OutputConflictMessage, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="Medium" Margin="80,0,0,8" Visibility="{Binding HasOutputConflictWithInput, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                <Border Background="{StaticResource DangerBackgroundBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBox Text="{Binding ErrorTitle, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"/>
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                        <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定 Execution Bar (FixedFooter) -->
        <Border x:Name="FixedFooter" Grid.Row="3" Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,14,0">
                        <TextBlock Text="结果文件:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="更改保存位置" Command="{Binding ChangeOutputPathCommand}" IsEnabled="{Binding CanConfigure}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBox Text="{Binding OutputFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFilePath}"/>
                    </DockPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Content="开始匹配" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132"/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="打开结果" Command="{Binding OpenResultFileCommand}" IsEnabled="{Binding CanExecuteSuccessActions}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="打开目录" Command="{Binding OpenResultFolderCommand}" IsEnabled="{Binding CanExecuteSuccessActions}" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <WrapPanel Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,2">
                            <TextBlock Text="{Binding ResultTotalMasterDataRowCount, StringFormat='总计 {0}  ·  '}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ResultMatchedCount, StringFormat='成功 {0}  ·  '}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="{Binding ResultUnmatchedCount, StringFormat='未匹配 {0}  ·  '}" Foreground="{StaticResource AccentGoldBrush}"/>
                            <TextBlock Text="{Binding ResultDuplicateCount, StringFormat='重复 {0}  ·  '}" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="{Binding ResultEmptyKeyCount, StringFormat='空键 {0}  ·  '}" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ResultSkippedCount, StringFormat='未参与 {0}'}" Foreground="{StaticResource TextMutedBrush}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ProgressStageText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ProgressBar Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}" Height="5" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
