<UserControl x:Class="TabularStudio.App.Views.DataMatchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DataMatchingViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="920">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0. 页面标题 -->
                <RowDefinition Height="Auto" /> <!-- 1. 输入表格选择 (主表 & 对照表) -->
                <RowDefinition Height="Auto" /> <!-- 2 & 3. 匹配条件与返回字段 -->
                <RowDefinition Height="Auto" /> <!-- 4. 匹配规则与容错选项 -->
                <RowDefinition Height="Auto" /> <!-- 5. 输出与执行 -->
            </Grid.RowDefinitions>

            <!-- 0. 页面标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="数据匹配 (Data Matching)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="完全离线 · 多字段精确匹配 · 仅支持 .xlsx 格式"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 1. 输入表格选择区 (主表 + 对照表) -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="1. 输入表格选择" Style="{StaticResource SectionHeaderStyle}" />

                    <!-- 主表 (Master Table) 配置卡片 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12"
                            AllowDrop="True"
                            DragOver="OnMasterDragOver"
                            Drop="OnMasterDrop">
                        <StackPanel>
                            <TextBlock Text="主表 (Master Table)"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <!-- 主表文件选择 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件路径:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding MasterFilePath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="White"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="6,4"
                                         FontSize="12"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="浏览 (O)..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseMasterFileCommand}"
                                        IsEnabled="{Binding CanBrowseMaster}" />
                            </Grid>

                            <!-- 主表 Sheet 与表头行 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="工作表:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding MasterWorksheets}"
                                          SelectedItem="{Binding SelectedMasterWorksheet}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding CanConfigure}"
                                          Padding="6,4"
                                          FontSize="12"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="表头所在行:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanConfigure}"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             Padding="4,3" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="▲"
                                                FontSize="7"
                                                Height="12"
                                                Padding="0"
                                                IsEnabled="{Binding CanConfigure}"
                                                Command="{Binding IncrementMasterHeaderRowCommand}" />
                                        <Button Content="▼"
                                                FontSize="7"
                                                Height="12"
                                                Padding="0"
                                                IsEnabled="{Binding CanConfigure}"
                                                Command="{Binding DecrementMasterHeaderRowCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 主表预览表格 -->
                            <Grid Height="120">
                                <DataGrid x:Name="MasterPreviewDataGrid"
                                          ItemsSource="{Binding MasterPreviewDataTable.DefaultView}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="OnMasterPreviewAutoGeneratingColumn"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserSortColumns="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E5E7EB"
                                          VerticalGridLinesBrush="#E5E7EB"
                                          Background="White"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1"
                                          FontSize="11" />

                                <Border Background="White"
                                        Visibility="{Binding ShowMasterPreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding MasterPreviewEmptyMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 对照表 (Reference Table) 配置卡片 -->
                    <Border Background="#F9FAFB"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            AllowDrop="True"
                            DragOver="OnReferenceDragOver"
                            Drop="OnReferenceDrop">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="对照表 (Reference Table)"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1"
                                          Content="与主表使用同一个文件"
                                          IsChecked="{Binding UseSameFileAsMaster}"
                                          IsEnabled="{Binding CanConfigure}"
                                          FontSize="12"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <!-- 对照表文件选择 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件路径:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ReferenceFilePath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="White"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="6,4"
                                         FontSize="12"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="2"
                                        Content="浏览 (R)..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BrowseReferenceFileCommand}"
                                        IsEnabled="{Binding CanBrowseReference}" />
                            </Grid>

                            <!-- 对照表 Sheet 与表头行 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="工作表:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ReferenceWorksheets}"
                                          SelectedItem="{Binding SelectedReferenceWorksheet}"
                                          DisplayMemberPath="Name"
                                          IsEnabled="{Binding CanConfigure}"
                                          Padding="6,4"
                                          FontSize="12"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3"
                                           Text="表头所在行:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanConfigure}"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             Padding="4,3" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="▲"
                                                FontSize="7"
                                                Height="12"
                                                Padding="0"
                                                IsEnabled="{Binding CanConfigure}"
                                                Command="{Binding IncrementReferenceHeaderRowCommand}" />
                                        <Button Content="▼"
                                                FontSize="7"
                                                Height="12"
                                                Padding="0"
                                                IsEnabled="{Binding CanConfigure}"
                                                Command="{Binding DecrementReferenceHeaderRowCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- 对照表预览表格 -->
                            <Grid Height="120">
                                <DataGrid x:Name="ReferencePreviewDataGrid"
                                          ItemsSource="{Binding ReferencePreviewDataTable.DefaultView}"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="OnReferencePreviewAutoGeneratingColumn"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserSortColumns="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E5E7EB"
                                          VerticalGridLinesBrush="#E5E7EB"
                                          Background="White"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1"
                                          FontSize="11" />

                                <Border Background="White"
                                        Visibility="{Binding ShowReferencePreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding ReferencePreviewEmptyMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2 & 3. 匹配条件与返回字段 (左右并排) -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <!-- 2. 匹配条件配置 (固定 AND) -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="2. 匹配条件配置 (固定 AND)"
                                   Style="{StaticResource SectionHeaderStyle}" />

                        <!-- 底部添加按钮与说明 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="+ 添加匹配条件"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddConditionCommand}"
                                    IsEnabled="{Binding CanConfigure}"
                                    Margin="0,0,0,6" />
                            <TextBlock Text="* 支持 1～N 条条件，所有条件必须同时满足 (AND)；空表头列不参与匹配。"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- 条件列表 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220" IsEnabled="{Binding CanConfigure}">
                            <ItemsControl ItemsSource="{Binding Conditions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MatchingConditionRowViewModel}">
                                        <StackPanel Margin="0,0,0,6">
                                            <!-- 条件间 AND 标识 -->
                                            <TextBlock Text="(且 / AND)"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Margin="8,0,0,4"
                                                       Visibility="{Binding ShowAndSeparator, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Index, StringFormat='条件 {0}:'}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding MasterColumns}"
                                                          SelectedItem="{Binding SelectedMasterColumn}"
                                                          DisplayMemberPath="DisplayName"
                                                          FontSize="12"
                                                          Padding="6,4"
                                                          VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="="
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding ReferenceColumns}"
                                                          SelectedItem="{Binding SelectedReferenceColumn}"
                                                          DisplayMemberPath="DisplayName"
                                                          FontSize="12"
                                                          Padding="6,4"
                                                          VerticalAlignment="Center" />

                                                <Button Grid.Column="4"
                                                        Content="删除"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DeleteCommand}"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Margin="6,0,0,0"
                                                        Padding="8,4"
                                                        FontSize="11" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 3. 选择带回字段 (从对照表) -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3. 选择带回字段"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedReturnFieldsCount, StringFormat='已选 {0} 项'}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 搜索与快捷全选栏 -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding SearchReturnFieldText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanConfigure}"
                                     FontSize="12"
                                     Padding="6,4"
                                     Margin="0,0,6,0" />

                            <Button Grid.Column="1"
                                    Content="全选"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectAllReturnFieldsCommand}"
                                    IsEnabled="{Binding CanConfigure}"
                                    Margin="0,0,4,0"
                                    Padding="8,4"
                                    FontSize="11" />

                            <Button Grid.Column="2"
                                    Content="反选"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding InvertReturnFieldsCommand}"
                                    IsEnabled="{Binding CanConfigure}"
                                    Padding="8,4"
                                    FontSize="11" />
                        </Grid>

                        <!-- 底部说明 -->
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="* 勾选字段追加至主表右侧；同名字段自动命名为 字段名_匹配"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <!-- 字段多选列表 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160" IsEnabled="{Binding CanConfigure}">
                            <ItemsControl ItemsSource="{Binding ReturnFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReturnFieldItemViewModel}">
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  FontSize="12"
                                                  Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 4. 匹配规则与容错选项 -->
            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="4. 匹配规则与容错选项" Style="{StaticResource SectionHeaderStyle}" />

                    <CheckBox Content="自动修复常见匹配差异 (空格/全半角/文本数字/日期统一，仅用于比较，不改源数据)"
                              IsChecked="{Binding NormalizeComparisonKeys}"
                              IsEnabled="{Binding CanConfigure}"
                              FontSize="12"
                              Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding CanConfigure}">
                        <CheckBox Content="生成匹配状态列"
                                  IsChecked="{Binding IsStatusColumnEnabled}"
                                  FontSize="12"
                                  VerticalAlignment="Center" />

                        <TextBlock Text="列名:"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,6,0" />

                        <TextBox Text="{Binding StatusColumnName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsStatusColumnEnabled}"
                                 Width="120"
                                 FontSize="12"
                                 Padding="6,3"
                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="* 容错策略：对照表出现重复匹配键时，对应主表记录返回字段留空，状态记为“重复”，不中止任务；未匹配记录返回字段留空。"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- 5. 输出与执行控制区 -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="5. 输出与执行" Style="{StaticResource SectionHeaderStyle}" />

                    <!-- 输出路径行 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="输出路径:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding OutputFilePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#F9FAFB"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Padding="8,6"
                                 FontSize="12"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="2"
                                Content="更改保存路径 (S)..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ChangeOutputPathCommand}"
                                IsEnabled="{Binding CanConfigure}" />
                    </Grid>

                    <!-- 输出路径冲突警告 -->
                    <TextBlock Text="{Binding OutputConflictMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="80,0,0,8"
                               Visibility="{Binding HasOutputConflictWithInput, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- 错误卡片 -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#991B1B"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ErrorDetail}"
                                       Foreground="#B91C1C"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- 成功统计卡片 (固定五项统计面板) -->
                    <Border Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SuccessMessage}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,8" />

                            <!-- 五项指标卡片展示 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="总计" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ResultTotalMasterDataRowCount, StringFormat='{}{0} 行'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="匹配成功" FontSize="11" Foreground="#065F46" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ResultMatchedCount, StringFormat='{}{0} 行'}" FontSize="15" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="未匹配" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ResultUnmatchedCount, StringFormat='{}{0} 行'}" FontSize="15" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="重复" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ResultDuplicateCount, StringFormat='{}{0} 行'}" FontSize="15" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="匹配键为空" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ResultEmptyKeyCount, StringFormat='{}{0} 行'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding ResultOutputFilePath, StringFormat='结果文件：{0}'}"
                                       Foreground="#065F46"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 进度指示 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar Height="8"
                                     Value="{Binding ProgressPercent}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Background="#E5E7EB"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"
                                     Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProgressStageText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Grid>

                    <!-- 操作按钮组 -->
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="开始数据匹配"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding CanStart}"
                                Margin="0,0,12,0" />

                        <Button Content="打开生成文件"
                                Style="{StaticResource SuccessButtonStyle}"
                                Command="{Binding OpenResultFileCommand}"
                                IsEnabled="{Binding CanExecuteSuccessActions}"
                                Margin="0,0,12,0" />

                        <Button Content="打开所在文件夹"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenResultFolderCommand}"
                                IsEnabled="{Binding CanExecuteSuccessActions}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
