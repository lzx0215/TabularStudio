<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:TabularStudio.App.ViewModels" Background="{StaticResource AppBackgroundBrush}" x:Class="TabularStudio.App.Views.DataMatchingView" d:DataContext="{d:DesignInstance Type=vm:DataMatchingViewModel}" mc:Ignorable="d" d:DesignHeight="950" d:DesignWidth="920" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.9*"/>
                <RowDefinition Height="1.1*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0" AllowDrop="True" DragOver="OnMasterDragOver" Drop="OnMasterDrop" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="主表" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" Grid.Row="0"/>
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding MasterFilePath, Mode=OneWay}" IsReadOnly="True" Background="White" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" FontSize="13" Margin="0,0,4,0" ToolTip="{Binding MasterFilePath, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="…" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseMasterFileCommand}" IsEnabled="{Binding CanBrowseMaster}" Margin="0,0,4,0" ToolTip="选择文件" Padding="6,4"/>
                            <TextBlock Visibility="{Binding HasMasterWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" Text="工作表:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Grid.Column="3" Margin="0,0,4,0"/>
                            <ComboBox Grid.Column="4" Visibility="{Binding HasMasterWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding MasterWorksheets}" SelectedItem="{Binding SelectedMasterWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" Padding="6,4" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="5" Text="表头行:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                            <Grid Grid.Column="6" Margin="0,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" FontSize="13" VerticalAlignment="Center" Padding="4,3" ToolTip="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="▲" FontSize="7" Height="16" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding IncrementMasterHeaderRowCommand}" MinHeight="0"/>
                                    <Button Content="▼" FontSize="7" Height="16" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding DecrementMasterHeaderRowCommand}" MinHeight="0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="MasterPreviewDataGrid" ItemsSource="{Binding MasterPreviewDataTable.DefaultView}" AutoGenerateColumns="True" AutoGeneratingColumn="OnMasterPreviewAutoGeneratingColumn" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="11"/>
                            <Border Background="White" Visibility="{Binding ShowMasterPreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding MasterPreviewEmptyMessage}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" AllowDrop="True" DragOver="OnReferenceDragOver" Drop="OnReferenceDrop" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="对照表" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <CheckBox Grid.Column="1" Content="与主表使用同一个文件" IsChecked="{Binding UseSameFileAsMaster}" IsEnabled="{Binding CanUseSameFile}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ReferenceFilePath, Mode=OneWay}" IsReadOnly="True" Background="White" BorderBrush="{StaticResource BorderBrush}" Padding="6,4" FontSize="13" Margin="0,0,4,0" ToolTip="{Binding ReferenceFilePath, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="…" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseReferenceFileCommand}" IsEnabled="{Binding CanBrowseReference}" Margin="0,0,4,0" ToolTip="选择文件" Padding="6,4"/>
                            <TextBlock Visibility="{Binding HasReferenceWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" Text="工作表:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Grid.Column="3" Margin="0,0,4,0"/>
                            <ComboBox Grid.Column="4" Visibility="{Binding HasReferenceWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}" ItemsSource="{Binding ReferenceWorksheets}" SelectedItem="{Binding SelectedReferenceWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" Padding="6,4" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="5" Text="表头行:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,4,0"/>
                            <Grid Grid.Column="6" Margin="0,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" FontSize="13" VerticalAlignment="Center" Padding="4,3" ToolTip="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="▲" FontSize="7" Height="16" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding IncrementReferenceHeaderRowCommand}" MinHeight="0"/>
                                    <Button Content="▼" FontSize="7" Height="16" Padding="0" IsEnabled="{Binding CanConfigure}" Command="{Binding DecrementReferenceHeaderRowCommand}" MinHeight="0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="ReferencePreviewDataGrid" ItemsSource="{Binding ReferencePreviewDataTable.DefaultView}" AutoGenerateColumns="True" AutoGeneratingColumn="OnReferencePreviewAutoGeneratingColumn" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" GridLinesVisibility="All" HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="11"/>
                            <Border Background="White" Visibility="{Binding ShowReferencePreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding ReferencePreviewEmptyMessage}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="匹配条件 · 全部满足" Style="{StaticResource SectionHeaderStyle}" TextWrapping="Wrap"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfigure}" Grid.Row="1">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Conditions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MatchingConditionRowViewModel}">
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="(且 / AND)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="8,0,0,4" Visibility="Collapsed" TextWrapping="Wrap"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index, StringFormat='条件 {0}:'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MasterColumns}" SelectedItem="{Binding SelectedMasterColumn}" DisplayMemberPath="DisplayName" FontSize="13" Padding="6,4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="→" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding ReferenceColumns}" SelectedItem="{Binding SelectedReferenceColumn}" DisplayMemberPath="DisplayName" FontSize="13" Padding="6,4" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4" Content="删除" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Margin="6,0,0,0" Padding="8,4" FontSize="13"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,8,0,0">
                                    <Button Content="+ 添加匹配条件" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddConditionCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,6"/>
                                    <TextBlock Text="* 支持 1～N 条条件，所有条件必须同时满足 (AND)；空表头列不参与匹配。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0" Grid.Column="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="带回字段" Style="{StaticResource SectionHeaderStyle}" Margin="0" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedReturnFieldsCount, StringFormat='已选 {0} 项'}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchReturnFieldText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" FontSize="13" Padding="6,4" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="全选" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllReturnFieldsCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,4,0" Padding="8,4" FontSize="13"/>
                                    <Button Grid.Column="2" Content="反选" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding InvertReturnFieldsCommand}" IsEnabled="{Binding CanConfigure}" Padding="8,4" FontSize="13"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="64" IsEnabled="{Binding CanConfigure}" MinHeight="28">
                                    <ItemsControl ItemsSource="{Binding ReturnFields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReturnFieldItemViewModel}">
                                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}" FontSize="13" Margin="0,0,12,4" ToolTip="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,6"/>
                            <StackPanel>
                                <StackPanel IsEnabled="{Binding CanConfigure}" Margin="0,0,0,4">
                                    <CheckBox Content="仅匹配满足条件的主表行" IsChecked="{Binding IsMasterFilterEnabled}" Margin="0,0,6,4" FontSize="13"/>
                                    <WrapPanel IsEnabled="{Binding IsMasterFilterEnabled}">
                                        <TextBlock Text="主表" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                        <ComboBox ItemsSource="{Binding MasterAvailableColumns}" SelectedItem="{Binding SelectedMasterFilterColumn}" DisplayMemberPath="DisplayName" MinWidth="120" MaxWidth="180" ToolTip="选择用于筛选主表行的列" Margin="0,0,8,0"/>
                                        <TextBlock Text="等于" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="MasterFilterValueSelector" ItemsSource="{Binding MasterFilterValues}"
                                                  SelectedItem="{Binding SelectedMasterFilterValue}" DisplayMemberPath="DisplayText"
                                                  IsEditable="False" IsEnabled="{Binding CanSelectMasterFilterValue}"
                                                  Width="170" MaxDropDownHeight="240" Margin="0,0,0,4"
                                                  ToolTip="从所选主表列的完整数据中选择实际值"/>
                                    </WrapPanel>
                                    <TextBox Text="{Binding MasterFilterValuesMessage, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" MaxHeight="56" BorderThickness="0" Padding="0" MinHeight="0"
                                             VerticalScrollBarVisibility="Auto" Background="Transparent" FontSize="12"
                                             Visibility="{Binding IsMasterFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <CheckBox Content="自动修复常见匹配差异（仅用于比较）" IsChecked="{Binding NormalizeComparisonKeys}" IsEnabled="{Binding CanConfigure}" FontSize="13" Margin="0,0,6,4" ToolTip="自动修复常见匹配差异 (空格/全半角/文本数字/日期统一，仅用于比较，不改源数据)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsEnabled="{Binding CanConfigure}">
                                    <CheckBox Content="生成匹配状态列" IsChecked="{Binding IsStatusColumnEnabled}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <TextBlock Text="列名:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,6,0" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding StatusColumnName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsStatusColumnEnabled}" Width="120" FontSize="13" Padding="6,3" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="96" Grid.Row="1">
            <StackPanel>
                <TextBox Text="{Binding OutputConflictMessage, Mode=OneWay}" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="Medium" Margin="80,0,0,8" Visibility="{Binding HasOutputConflictWithInput, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBox Text="{Binding ErrorTitle, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="#991B1B" FontSize="13" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                        <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" Foreground="#B91C1C" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}" IsReadOnly="True" BorderThickness="0" Padding="0" Background="Transparent" MinHeight="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="FixedFooter" Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock Text="结果文件" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="更改保存位置" Command="{Binding ChangeOutputPathCommand}" IsEnabled="{Binding CanConfigure}" Margin="6,0,0,0"/>
                        <TextBox Text="{Binding OutputFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFilePath}"/>
                    </DockPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Content="开始匹配" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132"/>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="打开结果" Command="{Binding OpenResultFileCommand}" IsEnabled="{Binding CanExecuteSuccessActions}" Margin="6,0,0,0"/>
                        <Button Content="打开目录" Command="{Binding OpenResultFolderCommand}" IsEnabled="{Binding CanExecuteSuccessActions}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <WrapPanel Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ResultTotalMasterDataRowCount, StringFormat='总计 {0}  ·  '}"/>
                            <TextBlock Text="{Binding ResultMatchedCount, StringFormat='成功 {0}  ·  '}"/>
                            <TextBlock Text="{Binding ResultUnmatchedCount, StringFormat='未匹配 {0}  ·  '}"/>
                            <TextBlock Text="{Binding ResultDuplicateCount, StringFormat='重复 {0}  ·  '}"/>
                            <TextBlock Text="{Binding ResultEmptyKeyCount, StringFormat='空键 {0}  ·  '}"/>
                            <TextBlock Text="{Binding ResultSkippedCount, StringFormat='未参与 {0}'}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ProgressStageText}" FontSize="12"/>
                        <ProgressBar Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}" Height="8" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
