<UserControl x:Class="TabularStudio.App.Views.DataMatchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TabularStudio.App.ViewModels"
             Background="Transparent"
             d:DataContext="{d:DesignInstance Type=vm:DataMatchingViewModel}"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="14">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*" MinHeight="140" />
            <RowDefinition Height="1.15*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 双表工作区 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid AllowDrop="True" DragOver="OnMasterDragOver" Drop="OnMasterDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="主表" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                <Border Grid.Row="1" Style="{StaticResource HorizontalHairlineStyle}" />
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding MasterFilePath, Mode=OneWay}" IsReadOnly="True"
                             ToolTip="{Binding MasterFilePath, Mode=OneWay}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Command="{Binding BrowseMasterFileCommand}" IsEnabled="{Binding CanBrowseMaster}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" ToolTip="选择主表文件" AutomationProperties.Name="选择主表文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,6,0" />
                            <TextBlock Text="选择…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Visibility="{Binding HasMasterWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="工作表" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding MasterWorksheets}" SelectedItem="{Binding SelectedMasterWorksheet}"
                                  DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock Text="表头行" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource InsetPanelStyle}" Width="72" Height="34">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button Style="{StaticResource SpinnerButtonStyle}" IsEnabled="{Binding CanConfigure}"
                                            Command="{Binding IncrementMasterHeaderRowCommand}" AutomationProperties.Name="主表表头行加一">
                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconChevronUp}" />
                                    </Button>
                                    <Button Style="{StaticResource SpinnerButtonStyle}" IsEnabled="{Binding CanConfigure}"
                                            Command="{Binding DecrementMasterHeaderRowCommand}" AutomationProperties.Name="主表表头行减一">
                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconChevronDown}" />
                                    </Button>
                                </StackPanel>
                                <TextBox Text="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanConfigure}" BorderThickness="0" Background="Transparent"
                                         MinHeight="0" Padding="8,0" VerticalContentAlignment="Center"
                                         ToolTip="{Binding MasterHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="4">
                    <DataGrid x:Name="MasterPreviewDataGrid"
                              ItemsSource="{Binding MasterPreviewDataTable.DefaultView}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="OnMasterPreviewAutoGeneratingColumn"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              MinHeight="88" />
                    <Border Style="{StaticResource EmptyOverlayStyle}"
                            Visibility="{Binding ShowMasterPreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding MasterPreviewEmptyMessage}" Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource VerticalHairlineStyle}" HorizontalAlignment="Center" Width="1" />
            <Grid Grid.Column="2" AllowDrop="True" DragOver="OnReferenceDragOver" Drop="OnReferenceDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="对照表" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                    <CheckBox DockPanel.Dock="Right" Content="与主表使用同一个文件" IsChecked="{Binding UseSameFileAsMaster}"
                              IsEnabled="{Binding CanUseSameFile}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource HorizontalHairlineStyle}" />
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding ReferenceFilePath, Mode=OneWay}" IsReadOnly="True"
                             ToolTip="{Binding ReferenceFilePath, Mode=OneWay}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Command="{Binding BrowseReferenceFileCommand}" IsEnabled="{Binding CanBrowseReference}"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" ToolTip="选择对照表文件" AutomationProperties.Name="选择对照表文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,6,0" />
                            <TextBlock Text="选择…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Visibility="{Binding HasReferenceWorksheetSelector, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="工作表" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding ReferenceWorksheets}" SelectedItem="{Binding SelectedReferenceWorksheet}"
                                  DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock Text="表头行" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource InsetPanelStyle}" Width="72" Height="34">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button Style="{StaticResource SpinnerButtonStyle}" IsEnabled="{Binding CanConfigure}"
                                            Command="{Binding IncrementReferenceHeaderRowCommand}" AutomationProperties.Name="对照表表头行加一">
                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconChevronUp}" />
                                    </Button>
                                    <Button Style="{StaticResource SpinnerButtonStyle}" IsEnabled="{Binding CanConfigure}"
                                            Command="{Binding DecrementReferenceHeaderRowCommand}" AutomationProperties.Name="对照表表头行减一">
                                        <Path Width="8" Height="5" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource IconChevronDown}" />
                                    </Button>
                                </StackPanel>
                                <TextBox Text="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanConfigure}" BorderThickness="0" Background="Transparent"
                                         MinHeight="0" Padding="8,0" VerticalContentAlignment="Center"
                                         ToolTip="{Binding ReferenceHeaderRowNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="4">
                    <DataGrid x:Name="ReferencePreviewDataGrid"
                              ItemsSource="{Binding ReferencePreviewDataTable.DefaultView}"
                              AutoGenerateColumns="True"
                              AutoGeneratingColumn="OnReferencePreviewAutoGeneratingColumn"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              MinHeight="88" />
                    <Border Style="{StaticResource EmptyOverlayStyle}"
                            Visibility="{Binding ShowReferencePreviewEmptyNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ReferencePreviewEmptyMessage}" Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 匹配条件 + 配置 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="匹配条件" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="全部同时满足 (AND)" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Style="{StaticResource HorizontalHairlineStyle}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfigure}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MatchingConditionRowViewModel}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="且" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,0,4"
                                                   Visibility="{Binding ShowAndSeparator, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index, StringFormat='条件 {0}'}" Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,8,0" MinWidth="52" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding MasterColumns}" SelectedItem="{Binding SelectedMasterColumn}"
                                                      DisplayMemberPath="DisplayName" />
                                            <Path Grid.Column="2" Data="{StaticResource IconLink}"
                                                  Width="16" Height="16" Margin="6,0" Stretch="Uniform"
                                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="精确对应，全部条件同时满足" />
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding ReferenceColumns}" SelectedItem="{Binding SelectedReferenceColumn}"
                                                      DisplayMemberPath="DisplayName" />
                                            <Button Grid.Column="4" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="10,6"
                                                    ToolTip="删除此条件" AutomationProperties.Name="删除匹配条件">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconTrash}" Margin="0,0,0,0" Width="12" Height="12" />
                                                    <TextBlock Text="删除" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Left" Command="{Binding AddConditionCommand}" IsEnabled="{Binding CanConfigure}"
                                Margin="0,4,0,8" AutomationProperties.Name="添加匹配条件">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconPlus}" />
                                <TextBlock Text="添加匹配条件" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="支持 1～N 条条件。所有条件必须同时满足；空表头列不参与匹配。" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource VerticalHairlineStyle}" HorizontalAlignment="Center" Width="1" />
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <TextBlock Text="处理配置与结果选项" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                <Border Style="{StaticResource HorizontalHairlineStyle}" />
                <StackPanel>
                    <Grid>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                  IsEnabled="{Binding CanSelectProfile}" AutomationProperties.Name="匹配配置" />
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,28,0" Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="请选择配置…" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                                            <Setter Property="Text" Value="暂无保存配置" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasProfiles}" Value="True" />
                                                <Condition Binding="{Binding SelectedProfile}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="请选择配置…" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="应用" Command="{Binding ApplyProfileCommand}" IsEnabled="{Binding CanApplyProfile}" />
                        <Button Grid.Column="2" Content="保存配置…" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding CanSaveProfile}" />
                        <Button Grid.Column="4" Content="删除" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanDeleteProfile}" />
                    </Grid>
                    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ProfileStatusMessage}" TextWrapping="Wrap" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfileStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProfileStatusModified}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProfileStatusSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                </StackPanel>
                <Border Style="{StaticResource HorizontalHairlineStyle}" Margin="0,12,0,12" />
                <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="带回字段" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedReturnFieldsCount, StringFormat='已选 {0} 项'}"
                                           FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchReturnFieldText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="全选" Command="{Binding SelectAllReturnFieldsCommand}"
                                        IsEnabled="{Binding CanConfigure}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="反选" Command="{Binding InvertReturnFieldsCommand}" IsEnabled="{Binding CanConfigure}" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72" IsEnabled="{Binding CanConfigure}" MinHeight="28">
                                <ItemsControl ItemsSource="{Binding ReturnFields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ReturnFieldItemViewModel}">
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Margin="0,0,12,6" ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                        <Border Style="{StaticResource HorizontalHairlineStyle}" Margin="0,10,0,10" />
                        <StackPanel>
                            <StackPanel IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8">
                                <CheckBox Content="仅匹配满足条件的主表行" IsChecked="{Binding IsMasterFilterEnabled}" Margin="0,0,0,8" />
                                <WrapPanel IsEnabled="{Binding IsMasterFilterEnabled}">
                                    <TextBlock Text="主表" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,6" />
                                    <ComboBox ItemsSource="{Binding MasterAvailableColumns}" SelectedItem="{Binding SelectedMasterFilterColumn}"
                                              DisplayMemberPath="DisplayName" MinWidth="120" MaxWidth="180"
                                              ToolTip="选择用于筛选主表行的列" Margin="0,0,8,6" />
                                    <TextBlock Text="等于" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,6" />
                                    <ComboBox x:Name="MasterFilterValueSelector" ItemsSource="{Binding MasterFilterValues}"
                                              SelectedItem="{Binding SelectedMasterFilterValue}" DisplayMemberPath="DisplayText"
                                              IsEditable="False" IsEnabled="{Binding CanSelectMasterFilterValue}"
                                              Width="170" MaxDropDownHeight="240" Margin="0,0,0,6"
                                              ToolTip="从所选主表列的完整数据中选择实际值" />
                                </WrapPanel>
                                <TextBox Text="{Binding MasterFilterValuesMessage, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}"
                                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="56" FontSize="12"
                                         VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding IsMasterFilterEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <CheckBox Content="自动修复常见匹配差异（仅用于比较）" IsChecked="{Binding NormalizeComparisonKeys}"
                                      IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8"
                                      ToolTip="自动修复常见匹配差异 (空格/全半角/文本数字/日期统一，仅用于比较，不改源数据)" />
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanConfigure}">
                                <CheckBox Content="生成匹配状态列" IsChecked="{Binding IsStatusColumnEnabled}" VerticalAlignment="Center" />
                                <TextBlock Text="列名" Style="{StaticResource FieldLabelStyle}" Margin="16,0,8,0" />
                                <TextBox Text="{Binding StatusColumnName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsStatusColumnEnabled}" Width="132" />
                            </StackPanel>
                        </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="96" Margin="0,8,0,0">
            <StackPanel>
                <TextBox Text="{Binding OutputConflictMessage, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}"
                         Foreground="{StaticResource DangerBrush}" FontWeight="Medium" Margin="0,0,0,8"
                         Visibility="{Binding HasOutputConflictWithInput, Converter={StaticResource BoolToVisibilityConverter}}"
                         TextWrapping="Wrap" IsReadOnly="True" />
                <Border Style="{StaticResource ErrorBannerStyle}" Margin="0,0,0,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBox Text="{Binding ErrorTitle, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}"
                                 FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"
                                 TextWrapping="Wrap" IsReadOnly="True" />
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}"
                                 Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" IsReadOnly="True" />
                        <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}"
                                 Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Visibility="{Binding HasErrorDetail, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsReadOnly="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="FixedFooter" Grid.Row="3" Style="{StaticResource FooterBarStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock Text="结果文件" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="更改保存位置" Command="{Binding ChangeOutputPathCommand}"
                                IsEnabled="{Binding CanConfigure}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding OutputFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFilePath}" />
                    </DockPanel>
                    <Button x:Name="StartButton" Grid.Column="2" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                            Style="{StaticResource PrimaryButtonStyle}" MinWidth="148" AutomationProperties.Name="开始匹配">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconPlay}" Fill="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="开始匹配" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding OpenResultFileCommand}" IsEnabled="{Binding CanExecuteSuccessActions}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFile}" Margin="0,0,6,0" />
                                <TextBlock Text="打开结果" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenResultFolderCommand}" IsEnabled="{Binding CanExecuteSuccessActions}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,6,0" />
                                <TextBlock Text="打开目录" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ResultTotalMasterDataRowCount, StringFormat='总计 {0}  ·  '}" />
                            <TextBlock Text="{Binding ResultMatchedCount, StringFormat='成功 {0}  ·  '}" />
                            <TextBlock Text="{Binding ResultUnmatchedCount, StringFormat='未匹配 {0}  ·  '}" />
                            <TextBlock Text="{Binding ResultDuplicateCount, StringFormat='重复 {0}  ·  '}" />
                            <TextBlock Text="{Binding ResultEmptyKeyCount, StringFormat='空键 {0}  ·  '}" />
                            <TextBlock Text="{Binding ResultSkippedCount, StringFormat='未参与 {0}'}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ProgressStageText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ProgressBar Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
