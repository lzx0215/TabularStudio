<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TabularStudio.App.Views.TableComparisonView"
             Background="Transparent"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="14"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="ComparisonValueTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="OptionalMessageStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,6,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左右双栏数据源：两侧各一条紧凑工具行。 -->
        <Grid Grid.Row="0" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- 表一 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="LeftWorksheetColumn" Width="172" MinWidth="120" MaxWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="表一" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="文件" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="LeftFileName" Grid.Column="2" Text="{Binding Left.FileName, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding Left.FilePath}" Style="{StaticResource Desktop.TextBoxStyle}" Margin="0,0,12,0"/>
                    <Button Grid.Column="3" Command="{Binding BrowseLeftCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Height="32" Width="112" Padding="{StaticResource Desktop.ButtonPadding}" Margin="0,0,16,0" AutomationProperties.Name="选择表一文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,6,0"/>
                            <TextBlock Text="选择文件…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="4" Text="工作表" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Left.Worksheets}" SelectedItem="{Binding Left.SelectedWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding Left.CanSelectSheet}" ToolTip="CSV 无需选择工作表" Style="{StaticResource Desktop.ComboBoxStyle}" Height="32"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="CSV 无需选择工作表。" Style="{StaticResource CaptionStyle}" Visibility="{Binding Left.IsCsv, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Left.ErrorMessage}" Style="{StaticResource OptionalMessageStyle}" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource VerticalHairlineStyle}" HorizontalAlignment="Center" Width="1"/>

            <!-- 表二 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="RightWorksheetColumn" Width="172" MinWidth="120" MaxWidth="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="表二" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="文件" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="RightFileName" Grid.Column="2" Text="{Binding Right.FileName, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding Right.FilePath}" Style="{StaticResource Desktop.TextBoxStyle}" Margin="0,0,12,0"/>
                    <Button Grid.Column="3" Command="{Binding BrowseRightCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Height="32" Width="112" Padding="{StaticResource Desktop.ButtonPadding}" Margin="0,0,16,0" AutomationProperties.Name="选择表二文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconFolder}" Margin="0,0,6,0"/>
                            <TextBlock Text="选择文件…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="4" Text="工作表" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Right.Worksheets}" SelectedItem="{Binding Right.SelectedWorksheet}" DisplayMemberPath="Name" IsEnabled="{Binding Right.CanSelectSheet}" ToolTip="CSV 无需选择工作表" Style="{StaticResource Desktop.ComboBoxStyle}" Height="32"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="CSV 无需选择工作表。" Style="{StaticResource CaptionStyle}" Visibility="{Binding Right.IsCsv, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Right.ErrorMessage}" Style="{StaticResource OptionalMessageStyle}" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 紧凑状态提示。 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" MinHeight="30" Padding="8,4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ResultSummary" Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result.AreEqual}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result.AreEqual}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ExtentHint}" Style="{StaticResource OptionalMessageStyle}" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding DifferenceHint}" Style="{StaticResource OptionalMessageStyle}" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource OptionalMessageStyle}" Foreground="{StaticResource DangerBrush}" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 差异明细表格占据全部剩余高度，内部滚动。 -->
        <DataGrid x:Name="DifferencesGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Differences}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  MinHeight="80"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  ToolTipService.ShowDuration="20000">
            <DataGrid.Columns>
                <DataGridTextColumn Header="位置" Binding="{Binding Address}" Width="88"/>
                <DataGridTextColumn Header="表一类型" Binding="{Binding LeftType}" Width="88"/>
                <DataGridTextColumn Header="表一值" Binding="{Binding LeftValue}" Width="*" ElementStyle="{StaticResource ComparisonValueTextStyle}"/>
                <DataGridTextColumn Header="表二类型" Binding="{Binding RightType}" Width="88"/>
                <DataGridTextColumn Header="表二值" Binding="{Binding RightValue}" Width="*" ElementStyle="{StaticResource ComparisonValueTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 固定底栏：按钮保留右对齐顺序。 -->
        <Border x:Name="FixedFooter" Grid.Row="3" Style="{StaticResource FooterBarStyle}" Margin="0,6,0,0" Padding="0,6,0,0">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ReportPath, Mode=OneWay}" Style="{StaticResource BareTextBoxStyle}" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" ToolTip="报告已保存的位置（可复制）"/>
                <ProgressBar Grid.Column="1" Width="120" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsBusy}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Height="32" Padding="{StaticResource Desktop.ButtonPadding}" Margin="0,0,8,0"/>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource Desktop.SecondaryButtonStyle}" Height="32" Padding="{StaticResource Desktop.ButtonPadding}" Margin="0,0,8,0" AutomationProperties.Name="导出全部差异">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeButtonGlyphStyle}" Data="{StaticResource IconExport}"/>
                            <TextBlock Text="导出全部差异…" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" Style="{StaticResource Desktop.PrimaryButtonStyle}" Height="32" MinWidth="148" Padding="{StaticResource Desktop.ButtonPadding}" AutomationProperties.Name="开始对比">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonGlyphStyle}" Data="{StaticResource IconPlay}" Fill="{StaticResource OnAccentBrush}"/>
                            <TextBlock Text="开始对比" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
